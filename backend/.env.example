# Copiar este archivo a ".env" y completar con los valores reales.
# El ".env" real NUNCA se sube al repositorio (ver .gitignore).

# Credenciales por defecto que se usan la primera vez que se migran cámaras
# desde cameras.json (instalación nueva). Una vez vinculadas desde el panel,
# cada cámara tiene sus propias credenciales (ver más abajo).
CAMERA_USER=admin
CAMERA_PASSWORD=cambiar_esta_contraseña

# Cada cuántos segundos el sistema muestrea las cámaras para reconocer rostros.
TRACKING_INTERVALO_SEGUNDOS=3

# Usuario y contraseña con los que se crea la cuenta de acceso al panel la
# primera vez que arranca el backend (si ya existe un usuario, esto se ignora).
ADMIN_USUARIO_INICIAL=reconadmin
ADMIN_PASSWORD_INICIAL=cambiar_esta_contraseña

# Credenciales por cámara: el sistema agrega/actualiza estas variables solo,
# cada vez que se vincula o edita una cámara desde "Configuración de cámaras"
# en el panel. No hace falta cargarlas a mano; quedan acá como referencia del
# formato que van a tener (CAM_<ID_DE_LA_CAMARA_EN_MAYÚSCULAS>_USER / _PASSWORD).
# CAM_CAM_FRENTE_USER=admin
# CAM_CAM_FRENTE_PASSWORD=cambiar_esta_contraseña
